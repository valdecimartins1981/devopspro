# ── DEV environment — example values ─────────────────────────────────────────
# Copy this file to terraform.tfvars and fill in real values.
# DO NOT commit secrets. Use TF_VAR_db_password for the password.

aws_region     = "us-east-1"
aws_account_id = "123456789012"
project_name   = "myapp"

vpc_cidr             = "10.10.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs  = ["10.10.1.0/24", "10.10.2.0/24"]
private_subnet_cidrs = ["10.10.11.0/24", "10.10.12.0/24"]

instance_count = 1
instance_type  = "t3.small"

db_instance_class = "db.t3.micro"
db_name           = "appdb"
db_username       = "dbadmin"
# db_password     = set via TF_VAR_db_password or CI/CD secret
